# Leave VITE_API_URL empty in development (Vite proxies /api to http://localhost:5000).
# In production set it to your API origin + /api, e.g. https://api.example.com/api
VITE_API_URL=
# Origin that serves /uploads images (empty = same origin / proxy)
VITE_ASSET_URL=
VITE_CURRENCY=INR
# Stripe publishable key (optional; without it the demo payment flow is used)
VITE_STRIPE_PK=
