PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/roomly

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d
REQUIRE_EMAIL_VERIFICATION=false

# Business rules
TAX_RATE=0.12
CURRENCY=inr
REQUIRE_BOOKING_APPROVAL=false
# Minutes offset from UTC used to decide what "today" is for check-ins (330 = IST)
TZ_OFFSET_MINUTES=330

# Email (nodemailer SMTP). Leave EMAIL_HOST empty to just log emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Roomly <no-reply@roomly.test>"

# Payments (Stripe). Leave empty to use demo/mock payments (non-production only).
STRIPE_SECRET_KEY=
ALLOW_MOCK_PAYMENTS=true

# Cloud storage for room images (optional; local /uploads is used by default)
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_SECRET=
CLOUD_STORAGE_BUCKET=
